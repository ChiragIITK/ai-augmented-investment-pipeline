# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Required only to GENERATE new analyses (Stage 3). The committed pipeline
# replays from data/llm_cache/ without a key.
ANTHROPIC_API_KEY=####

# Optional. Defaults to claude-opus-4-8. Set to claude-sonnet-5 for lower cost.
# PIPELINE_MODEL=claude-sonnet-5

# Optional. Set to 1 to force offline replay (serve from committed cache only).
# PIPELINE_OFFLINE=1
